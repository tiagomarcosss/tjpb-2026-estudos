filters:
  and:
    - '!file.inFolder("modelos")'
    - or:
        - tipo == "bloco"
        - tipo == "prova"
        - tipo == "resumo"
properties:
  file.name:
    displayName: Arquivo
views:
  - type: table
    name: Blocos aguardando correção
    filters:
      and:
        - tipo == "bloco"
        - status == "pendente"
    order:
      - data
      - semana
      - disciplina
      - assunto
      - file.name
    sort:
      - property: data
        direction: DESC
  - type: table
    name: Todos os blocos e provas
    filters:
      or:
        - tipo == "bloco"
        - tipo == "prova"
    order:
      - data
      - tipo
      - fonte
      - disciplina
      - assunto
      - status
      - file.name
    sort:
      - property: data
        direction: DESC
  - type: table
    name: Resumos
    filters:
      and:
        - tipo == "resumo"
    groupBy:
      property: disciplina
      direction: ASC
    order:
      - file.name
      - assunto
      - atualizado
