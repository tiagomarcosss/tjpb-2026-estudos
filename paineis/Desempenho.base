filters:
  and:
    - '!file.inFolder("modelos")'
    - or:
        - tipo == "correcao"
        - tipo == "simulado"
        - tipo == "discursiva"
formulas:
  aproveitamento: if(total, (acertos / total * 100).round() + "%", "")
properties:
  formula.aproveitamento:
    displayName: Aproveitamento
  file.name:
    displayName: Arquivo
views:
  - type: table
    name: Linha do tempo
    order:
      - data
      - tipo
      - fonte
      - disciplina
      - assunto
      - acertos
      - total
      - formula.aproveitamento
      - file.name
    sort:
      - property: data
        direction: DESC
  - type: table
    name: Por disciplina
    groupBy:
      property: disciplina
      direction: ASC
    order:
      - data
      - assunto
      - acertos
      - total
      - formula.aproveitamento
      - file.name
    sort:
      - property: data
        direction: DESC
  - type: table
    name: Só provas oficiais
    filters:
      and:
        - fonte == "oficial"
    order:
      - data
      - prova
      - disciplina
      - acertos
      - total
      - formula.aproveitamento
      - file.name
    sort:
      - property: data
        direction: DESC
  - type: table
    name: Simulados
    filters:
      and:
        - tipo == "simulado"
    order:
      - data
      - prova
      - portugues
      - rlm
      - especificas
      - discursiva_nota
      - acertos
      - total
      - formula.aproveitamento
      - file.name
    sort:
      - property: data
        direction: DESC
